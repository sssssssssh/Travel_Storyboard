# ============================================================
# Travel Storyboard — configuration template (release version: root VERSION)
# Copy to `.env` and adjust. All keys are optional; defaults apply.
# ============================================================

# --- Server ---
# Bind host (always loopback for privacy). Do NOT expose publicly.
TRAVELSB_BIND_HOST=127.0.0.1
TRAVELSB_BIND_PORT=8737

# --- Storage ---
# Directory for the SQLite database, thumbnails, proxies and logs.
TRAVELSB_DATA_DIR=./data
# SQLAlchemy URL. Default is a local SQLite file under DATA_DIR.
# Swap to Postgres etc. by setting a full URL (e.g. postgresql+psycopg://...)
TRAVELSB_DATABASE_URL=

# --- FFmpeg ---
# Leave blank to auto-detect ffmpeg/ffprobe from PATH or common locations.
TRAVELSB_FFMPEG_PATH=
TRAVELSB_FFPROBE_PATH=

# --- Processing ---
# Concurrent media jobs (default 2; keep low to protect disk I/O).
TRAVELSB_MAX_CONCURRENCY=2
# Representative-frame / thumbnail target width in px.
TRAVELSB_THUMB_WIDTH=640
# Preview proxy width in px (low-res review clips).
TRAVELSB_PROXY_WIDTH=480

# --- AI model (optional; used by the direct model API integration in M3) ---
# OpenAI-compatible base URL, API key and model name.
TRAVELSB_MODEL_BASE_URL=
TRAVELSB_MODEL_API_KEY=
TRAVELSB_MODEL_NAME=

# --- Vision model guard rails (M5 / TSB-302) ---
# Request timeout, per-request image cap, body cap and per-job call budget.
TRAVELSB_MODEL_TIMEOUT_SEC=120
TRAVELSB_MODEL_MAX_IMAGES=4
TRAVELSB_MODEL_MAX_REQUEST_BYTES=8000000
TRAVELSB_MODEL_MAX_CALLS_PER_JOB=200
TRAVELSB_MODEL_MAX_RETRIES=2
# Declared capabilities. Native video is opt-in: never assume a gateway takes MP4.
TRAVELSB_MODEL_SUPPORTS_JSON_SCHEMA=false
TRAVELSB_MODEL_SUPPORTS_NATIVE_VIDEO=false
# DEVELOPMENT/TEST ONLY exception. Must remain false for production acceptance.
# Images AND the bearer token travel unencrypted when enabled.
# Use owner-provided HTTPS or an authenticated encrypted tunnel instead.
TRAVELSB_MODEL_ALLOW_INSECURE_HTTP=false

# --- Vision semantics (M5 / TSB-303, TSB-304) ---
# Master switch for sending privacy-rendered JPEGs to a model. Default: off.
TRAVELSB_MODEL_MODE=off
TRAVELSB_VISION_PROMPT_VERSION=1.0
TRAVELSB_VISION_SCHEMA_VERSION=1.0
TRAVELSB_VISION_MAX_SEGMENTS_PER_JOB=200
TRAVELSB_VISION_TARGET_WIDTH=768
# Output-token ceilings. Reasoning models (e.g. GLM-5.3-Flash) spend part of
# this budget on a separate `reasoning` field; too small a value makes them
# return content=null, which is reported as MODEL_INVALID_OUTPUT rather than
# being mistaken for an empty success.
TRAVELSB_VISION_MAX_TOKENS=4000
TRAVELSB_VISION_MAX_TOKENS_MOTION=4000
# Motion review (TSB-307): timestamped frames sampled inside the valid interval.
TRAVELSB_MOTION_FRAME_COUNT=5

# --- Logging ---
TRAVELSB_LOG_LEVEL=INFO
