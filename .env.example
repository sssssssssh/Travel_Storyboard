# ============================================================
# Travel Storyboard v2.0 — configuration template
# Copy to `.env` and adjust. All keys are optional; defaults apply.
# ============================================================

# --- Server ---
# Bind host (always loopback for privacy). Do NOT expose publicly.
TRAVELSB_BIND_HOST=127.0.0.1
TRAVELSB_BIND_PORT=8737

# --- Storage ---
# Directory for the SQLite database, thumbnails, proxies and logs.
TRAVELSB_DATA_DIR=./data
# SQLAlchemy URL. Default is a local SQLite file under DATA_DIR.
# Swap to Postgres etc. by setting a full URL (e.g. postgresql+psycopg://...)
TRAVELSB_DATABASE_URL=

# --- FFmpeg ---
# Leave blank to auto-detect ffmpeg/ffprobe from PATH or common locations.
TRAVELSB_FFMPEG_PATH=
TRAVELSB_FFPROBE_PATH=

# --- Processing ---
# Concurrent media jobs (default 2; keep low to protect disk I/O).
TRAVELSB_MAX_CONCURRENCY=2
# Representative-frame / thumbnail target width in px.
TRAVELSB_THUMB_WIDTH=640
# Preview proxy width in px (low-res review clips).
TRAVELSB_PROXY_WIDTH=480

# --- AI model (optional; used by the direct model API integration in M3) ---
# OpenAI-compatible base URL, API key and model name.
TRAVELSB_MODEL_BASE_URL=
TRAVELSB_MODEL_API_KEY=
TRAVELSB_MODEL_NAME=

# --- Logging ---
TRAVELSB_LOG_LEVEL=INFO
